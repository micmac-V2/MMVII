#!/bin/bash

_mmvii_completion()
{
  export COMP_LINE COLUMNS
  local cur cword
  _get_comp_words_by_ref -n = cur cword
  local RESULT="$(${_MMVII_COMPLETION_INTERPRETER} -  "$cur" "$cword" < ${_MMVII_COMPLETION_PYTHON})"
  readarray -t COMPREPLY < <(echo -n "$RESULT")
  if [ ${#COMPREPLY[@]} -eq 0 ]; then
    unset COMPREPLY
  elif [[ ${COMPREPLY[-1]} == Options:* ]]; then
    local options=${COMPREPLY[-1]}
    unset COMPREPLY[-1]
    eval compopt ${options##Options:}
  elif [[ ${COMPREPLY[-1]} == File:* ]]; then
    local file=${COMPREPLY[-1]}
    unset COMPREPLY[-1]
    command=${file##File:}
    COMPREPLY+=($(eval $command | sort))
    compopt -o nosort
    if [[ ${COMPREPLY[0]} != '>'* ]]; then
      compopt -o filenames
    fi
  fi
}

# Resolve the interpreter once, here, and not on each completion: Ubuntu has provided
# no "python" at all since 20.04 unless python-is-python3 is installed, while on Windows
# only "python" exists, and it may be a python2 unable to run the completion script.
_MMVII_COMPLETION_INTERPRETER=
if command -v python3 > /dev/null 2>&1 ; then
  _MMVII_COMPLETION_INTERPRETER=python3
elif command -v python > /dev/null 2>&1 && python -c 'import sys ; sys.exit(sys.version_info[0] < 3)' > /dev/null 2>&1 ; then
  _MMVII_COMPLETION_INTERPRETER=python
fi

_MMVII_COMPLETION_PYTHON=$(dirname ${BASH_SOURCE[0]})/mmvii-completion.py
if [ -n "${_MMVII_COMPLETION_INTERPRETER}" ] ; then
  complete -F _mmvii_completion MMVII MMVII.exe mmvii mmvii.exe
fi

