#!/bin/bash
#
# Run *inside* the MMVII container image, under Docker or Singularity/Apptainer.
#
#   without argument   prints the command the user has to type on the host;
#   --emit [<image>]   prints, on stdout, the shell code that command sources.
#
# Nothing is installed on the host and no volume is needed: a container can neither
# write in the host filesystem nor alter the host shell, so everything travels through
# stdout and is executed by the host when it sources the result.
#
# What the host ends up with:
#   - a cache directory under its own temporary directory, holding the output of the
#     two MMVII calls the completion would otherwise make;
#   - the completion itself, reading that cache instead of running MMVII -- which it
#     could not do, MMVII existing only in the image;
#   - an exported MMVII shell function running the image, so that the completed
#     command line can actually be executed, from the shell itself or from a bash
#     script started from it.
#
# The cache is a snapshot: sourcing this again rebuilds it, which is what a new image
# requires.

set -u

MMVII_DIR=$(dirname "$(dirname "$(readlink -f "$0")")")

# Which runtime is running us. Apptainer defines both variables, for compatibility
# with Singularity, so it has to be tested first. Both hold the path of the image
# *on the host*, which is exactly what the host command needs to name.
if [ -n "${APPTAINER_CONTAINER:-}" ] ; then
    RUNTIME=apptainer
    IMAGE=$APPTAINER_CONTAINER
elif [ -n "${SINGULARITY_CONTAINER:-}" ] ; then
    RUNTIME=singularity
    IMAGE=$SINGULARITY_CONTAINER
else
    RUNTIME=docker
    # Docker exposes no name for the image a container was started from -- the
    # hostname is the container id. MMVII_IMAGE is therefore written into the image
    # when it is built (see .github/docker/Dockerfile); an image built without it
    # falls back on the argument, and then on a placeholder for the user to replace.
    IMAGE=${MMVII_IMAGE:-}
    [ -z "$IMAGE" ] && IMAGE=${2:-}
    [ -z "$IMAGE" ] && IMAGE='<image>'
fi

#  How the host starts a container of this image, the one word that differs between
#  the runtimes; used by the show mode and nowhere else.
if [ "$RUNTIME" = docker ] ; then
    RUN_IMAGE="docker run --rm $IMAGE"
else
    RUN_IMAGE="$RUNTIME exec $IMAGE"
fi

if [ "${1:-}" != "--emit" ] ; then
    #  Show mode: the command to type.
    echo "To give this shell the MMVII command and its completion, type:"
    echo
    echo "    source <($RUN_IMAGE mmvii-bash-init --emit)"
    echo
    if [ "$IMAGE" = '<image>' ] ; then
        echo "Replace <image> by the image this container was started from: Docker does"
        echo "not expose it, and this image was built without MMVII_IMAGE."
        echo
    fi
    echo "MMVII then runs the container, and works in the current directory."
    exit 0
fi

# Quoted delimiters: the host must receive these payloads verbatim. Both are MMVII
# output, so neither can contain a line reducing to the delimiter.
cat <<'__MMVII_INIT_HEAD__'
# --- MMVII container support, generated by mmvii-bash-init ---------------------
# Must be set before the completion below, which keeps an already assigned value.
_MMVII_COMPLETION_CACHE="${TMPDIR:-/tmp}/mmvii-completion-$(id -u)"
mkdir -p "$_MMVII_COMPLETION_CACHE"
__MMVII_INIT_HEAD__

echo "cat > \"\$_MMVII_COMPLETION_CACHE/GenArgsSpec.json\" <<'__MMVII_SPECS__'"
MMVII GenArgsSpec
echo "__MMVII_SPECS__"

echo "cat > \"\$_MMVII_COMPLETION_CACHE/BenchNames.txt\" <<'__MMVII_BENCHES__'"
MMVII Bench 1 PatBench=XXX
echo "__MMVII_BENCHES__"

# The command the completion completes: completion is registered on the word MMVII,
# and the lookup is on that word, so completing a function works.
#
# A function rather than an alias, and exported: an alias exists only in the shell
# that defines it, while an exported function is inherited by the bash scripts started
# from it, which is where an MMVII command line is often written. It stops there --
# a /bin/sh script, or a program calling MMVII through execve, sees neither.
#
# Everything below is expanded when the function is called, not here.
if [ "$RUNTIME" = docker ] ; then
    # Reproduces what Singularity/Apptainer gives for free, so that both behave alike:
    #   --user      the image runs as uid 1000, which can write in a bind mounted
    #               directory only if the host account happens to be uid 1000 too;
    #               without this, MMVII cannot even write its log file;
    #   HOME        so the profile is the user's own, and is writable;
    #   $PWD:$PWD   host paths, not /data: an absolute path means the same on both
    #               sides, which the File: completions need -- they are expanded by
    #               the host shell and therefore list host paths.
    # Overlapping mounts are accepted, so $PWD inside $HOME needs no special case.
    # -t only when there is a terminal, else docker ends every redirected line with
    # a carriage return.
    cat <<__MMVII_INIT_CMD__
MMVII()
{
    local aTty=
    [ -t 0 ] && aTty=-t
    docker run --rm -i \$aTty --user "\$(id -u):\$(id -g)" -e HOME="\$HOME" \\
        -v "\$HOME:\$HOME" -v "\$PWD:\$PWD" -w "\$PWD" $IMAGE MMVII "\$@"
}
export -f MMVII
__MMVII_INIT_CMD__
else
    # Nothing to mount: Singularity/Apptainer binds the current directory and $HOME,
    # and keeps the current directory, so paths already mean the same on both sides.
    cat <<__MMVII_INIT_CMD__
MMVII()
{
    $RUNTIME exec $IMAGE MMVII "\$@"
}
export -f MMVII
__MMVII_INIT_CMD__
fi

# Self-contained: make_completion.sh inlines the python script in it as a here
# document, so sourcing it from a pipe, with no file of its own, works.
cat "$MMVII_DIR/bash-completion/mmvii-completion"
echo "# --- end of MMVII container support -------------------------------------------"
