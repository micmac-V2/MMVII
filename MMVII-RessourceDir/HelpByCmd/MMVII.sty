%=============================================================================
% MMVII.sty : common style for the MMVII help documents
%=============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{MMVII}[2026/10/19 Style for MMVII command documentation]

%-----------------------------------------------------------------------------
%  Packages
%-----------------------------------------------------------------------------

\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{comment}
\RequirePackage{graphicx}
\RequirePackage{amssymb}
\RequirePackage{xspace}
\usepackage{xcolor}   % dans le préambule

%-----------------------------------------------------------------------------
%  Basic names and styles
%-----------------------------------------------------------------------------

\newcommand{\MMVII}{MMVII\xspace}

% Unify all the text that corresponds to names of files, commands
\newcommand{\FileSty}[1]{\texttt{#1}}

\newcommand{\Param}[1]{\textit{#1}}
\newcommand{\ParamCam}{\Param{Cam}}

% Ignore its argument (quick way to comment out a block of text)
\newcommand{\COM}[1]{}

%-----------------------------------------------------------------------------
%  Title and standard sections
%-----------------------------------------------------------------------------

\newcommand{\CmdTitle}
{
  \begin{center}
    {\Large \bfseries Help for command \TheCmd}
  \end{center}
}

\newcommand{\SecDescr}{\section{Description of \TheCmd}}

\newcommand{\LabelCSVRes}{SEC:CSV:RES}
\newcommand{\SecCSVRes}
{
  \section{Generated report as \FileSty{csv} files by \TheCmd}
  \label{\LabelCSVRes}
}
\newcommand{\RefSecCSVRes}{section~\ref{\LabelCSVRes}}

\newcommand{\LabelVisuRes}{SEC:VISU:RES}
\newcommand{\SecVisuRes}
{
  \section{Generated visualisation files by \TheCmd}
  \label{\LabelVisuRes}
}
\newcommand{\RefSecVisuRes}{section~\ref{\LabelVisuRes}}

\newcommand{\SecRelatedCmd}
{
  \section{Commands related to \TheCmd}
  \label{Ref:RelCmd}
  See also:
}

\newcommand{\SubSecTiePRelOr}[1]
{
  \subsection{Optional mandatory parameter for tie points}

  #1.
  The specification of these tie points is similar to all commands on
  relative orientation, see \FileSty{OriPoseEstimRel2Im.pdf}.
}

\endinput
